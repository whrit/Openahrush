# Openahrush Environment Configuration
# Copy this file to .env and update with your values
# Never commit secrets or credentials to version control

# ============================================================================
# Core Application
# ============================================================================

# Environment (development, staging, production)
ENVIRONMENT=development

# Logging level (debug, info, warning, error, critical)
LOG_LEVEL=debug

# API server port (used in local dev)
API_PORT=8000

# ============================================================================
# Database (PostgreSQL)
# ============================================================================

# PostgreSQL connection string
# Format: postgresql+psycopg://user:password@host:port/database
# In Docker Compose:
DATABASE_URL=postgresql+psycopg://semrush:semrush@postgres:5432/semrush

# Alternative if using localhost (for direct psql access)
# DATABASE_URL=postgresql+psycopg://semrush:semrush@localhost:5432/semrush

# Alembic migrations path (relative to project root)
ALEMBIC_INI_PATH=migrations/alembic.ini

# ============================================================================
# Cache & Message Queue (Redis)
# ============================================================================

# Redis connection string
# Format: redis://[:password]@host:port/db
# In Docker Compose:
REDIS_URL=redis://redis:6379/0

# Alternative for localhost:
# REDIS_URL=redis://localhost:6379/0

# ============================================================================
# Object Storage (MinIO/S3)
# ============================================================================

# MinIO endpoint URL (without protocol)
# Docker Compose: minio:9000
# Local: localhost:9000
MINIO_ENDPOINT=http://minio:9000

# MinIO access key (username)
# Default credentials for dev environment
MINIO_ACCESS_KEY=minioadmin

# MinIO secret key (password)
# Change in production!
MINIO_SECRET_KEY=minioadmin

# S3-compatible bucket name for artifacts
S3_BUCKET=openahrush

# AWS region for S3 operations (for compatibility)
AWS_REGION=us-east-1

# ============================================================================
# Security & Encryption
# ============================================================================

# JWT secret for token signing
# Generate with: openssl rand -base64 32
# NEVER use the default in production!
JWT_SECRET=dev-secret-key-change-in-production

# JWT token expiration time (in seconds)
JWT_EXPIRATION=3600

# Encryption key for sensitive data at rest
# Generate with: openssl rand -base64 32
# Must be exactly 32 bytes for AES-256
# NEVER use the default in production!
ENCRYPTION_KEY=dev-encryption-key-change-in-production

# ============================================================================
# Google OAuth & Integrations
# ============================================================================

# Google OAuth Client ID
# Obtain from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=

# Google OAuth Client Secret
# Obtain from: https://console.cloud.google.com/
GOOGLE_CLIENT_SECRET=

# Google OAuth Redirect URI
# Must match configured URI in Google Console
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ============================================================================
# ClickHouse (Optional - for Common Crawl)
# ============================================================================

# ClickHouse HTTP connection string
# Only required if using Common Crawl ingestion features
# Docker Compose: http://clickhouse:8123
# Local: http://localhost:8123
CLICKHOUSE_URL=http://clickhouse:8123

# ClickHouse database name
CLICKHOUSE_DATABASE=openahrush

# ClickHouse username (default: 'default')
CLICKHOUSE_USER=default

# ClickHouse password
CLICKHOUSE_PASSWORD=default

# ============================================================================
# Feature Flags
# ============================================================================

# Enable Common Crawl ingestion pipeline
FEATURE_COMMONCRAWL_INGEST=true

# Enable search console integration
FEATURE_GSC_INTEGRATION=true

# Enable Google Analytics integration
FEATURE_GA4_INTEGRATION=true

# Enable backlink analysis features
FEATURE_BACKLINK_ANALYSIS=true

# ============================================================================
# Crawler Configuration
# ============================================================================

# Default crawl depth (number of hops from seed URLs)
DEFAULT_CRAWL_DEPTH=3

# Maximum concurrent crawl requests per project
MAX_CONCURRENT_CRAWLS=5

# Request timeout for crawled URLs (seconds)
CRAWL_REQUEST_TIMEOUT=30

# Use Playwright for JavaScript-heavy sites (fallback)
# Set to 'true' to enable, requires additional dependencies
USE_PLAYWRIGHT_FALLBACK=false

# ============================================================================
# Email Configuration (Optional)
# ============================================================================

# SMTP server hostname
SMTP_HOST=

# SMTP server port
SMTP_PORT=587

# SMTP username
SMTP_USER=

# SMTP password
SMTP_PASSWORD=

# Email sender address
MAIL_FROM=noreply@openahrush.local

# Enable email notifications
ENABLE_EMAIL_NOTIFICATIONS=false

# ============================================================================
# Monitoring & Observability
# ============================================================================

# OpenTelemetry collector endpoint (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# Enable request logging
ENABLE_REQUEST_LOGGING=true

# Enable slow query logging
ENABLE_SLOW_QUERY_LOGGING=true

# Slow query threshold (milliseconds)
SLOW_QUERY_THRESHOLD=1000

# ============================================================================
# Development Settings
# ============================================================================

# Enable debug mode (more verbose logging, auto-reload)
DEBUG=true

# Allow insecure cookies (for development only)
SECURE_COOKIES=false

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# API documentation accessible
ENABLE_API_DOCS=true

# Enable admin endpoints (if needed for development)
ENABLE_ADMIN_ENDPOINTS=true
