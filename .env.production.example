# Openahrush Production Environment Configuration
# Copy this file to .env.prod and update with your production values
# CRITICAL: Replace all placeholder values with strong, unique secrets

# ============================================================================
# Core Application
# ============================================================================

ENVIRONMENT=production
LOG_LEVEL=info
DEBUG=false
API_PORT=8000
API_HOST=0.0.0.0

# ============================================================================
# Database (PostgreSQL)
# ============================================================================

# REQUIRED: Update with strong password
# Format: postgresql+psycopg://user:password@host:port/database
DATABASE_URL=postgresql+psycopg://semrush:CHANGE_THIS_STRONG_PASSWORD@postgres:5432/semrush

# Production database tuning
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_ECHO=false

# PostgreSQL container settings
POSTGRES_USER=semrush
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
POSTGRES_DB=semrush
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=2GB
POSTGRES_WORK_MEM=16MB
POSTGRES_MAINTENANCE_WORK_MEM=256MB

# ============================================================================
# Cache & Message Queue (Redis)
# ============================================================================

# REQUIRED: Update with password
REDIS_URL=redis://:CHANGE_THIS_REDIS_PASSWORD@redis:6379/0
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD
REDIS_MAXMEMORY=512mb
REDIS_MAX_CONNECTIONS=50

# ============================================================================
# Object Storage (MinIO/S3)
# ============================================================================

# Option 1: Self-hosted MinIO
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=CHANGE_THIS_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_THIS_SECRET_KEY_MIN_32_CHARS
S3_BUCKET=openahrush-prod
AWS_REGION=us-east-1
MINIO_BROWSER=on
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Option 2: AWS S3 (uncomment and configure)
# MINIO_ENDPOINT=https://s3.amazonaws.com
# MINIO_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
# MINIO_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# S3_BUCKET=your-openahrush-bucket
# AWS_REGION=us-west-2
# MINIO_SECURE=true

# ============================================================================
# Security & Encryption
# ============================================================================

# REQUIRED: Generate with: openssl rand -base64 32
# CRITICAL: Must be at least 32 characters
JWT_SECRET=CHANGE_THIS_GENERATE_WITH_OPENSSL_RAND_BASE64_32

# JWT expiration (in minutes)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# REQUIRED: Generate with Fernet
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CRITICAL: Must be valid Fernet key
ENCRYPTION_KEY=CHANGE_THIS_GENERATE_WITH_FERNET_GENERATE_KEY

# Production security settings
SECURE_COOKIES=true

# ============================================================================
# Google OAuth & Integrations
# ============================================================================

# REQUIRED for GSC/GA4: Obtain from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-YOUR_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://yourdomain.com/integrations/google/callback

# ============================================================================
# Microsoft OAuth (for Bing Webmaster Tools)
# ============================================================================

# Optional: Configure for Bing Webmaster Tools integration
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://yourdomain.com/integrations/microsoft/callback
MICROSOFT_TENANT_ID=common

# ============================================================================
# ClickHouse (Optional - for Common Crawl at scale)
# ============================================================================

# Enable with: docker compose --profile clickhouse up -d
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DATABASE=openahrush
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=CHANGE_THIS_CLICKHOUSE_PASSWORD
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# ============================================================================
# Feature Flags
# ============================================================================

FEATURE_COMMONCRAWL_INGEST=true
FEATURE_GSC_INTEGRATION=true
FEATURE_GA4_INTEGRATION=true
FEATURE_BWT_INTEGRATION=true
FEATURE_BACKLINK_ANALYSIS=true

# API Documentation (disable in production for security)
ENABLE_API_DOCS=false

# Admin endpoints (disable unless needed)
ENABLE_ADMIN_ENDPOINTS=false

# ============================================================================
# Crawler Configuration
# ============================================================================

DEFAULT_CRAWL_DEPTH=3
MAX_CONCURRENT_CRAWLS=5
CRAWL_REQUEST_TIMEOUT=30
USE_PLAYWRIGHT_FALLBACK=true
USER_AGENT=Openahrush/0.1.0 (+https://openahrush.org)

# ============================================================================
# Worker Configuration
# ============================================================================

WORKER_CONCURRENCY=4
WORKER_REPLICAS=1

# ============================================================================
# Email Configuration (Optional)
# ============================================================================

# SMTP Configuration for notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@yourdomain.com
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_TLS=true
MAIL_FROM=noreply@yourdomain.com
ENABLE_EMAIL_NOTIFICATIONS=true

# ============================================================================
# Monitoring & Observability
# ============================================================================

# Sentry for error tracking (recommended)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# OpenTelemetry (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Logging
ENABLE_REQUEST_LOGGING=true
ENABLE_SLOW_QUERY_LOGGING=true
SLOW_QUERY_THRESHOLD=1000

# ============================================================================
# CORS Configuration
# ============================================================================

# Comma-separated list of allowed origins
# IMPORTANT: Do not use wildcard (*) in production
CORS_ORIGINS=https://app.yourdomain.com,https://yourdomain.com

# ============================================================================
# Data Persistence
# ============================================================================

# Directory for persistent data volumes
# Ensure this directory exists and has proper permissions
DATA_DIR=/var/lib/openahrush

# ============================================================================
# Application Version
# ============================================================================

# Used for image tagging
VERSION=latest

# ============================================================================
# Deployment Notes
# ============================================================================

# Before deploying to production:
# 1. Generate all secrets (JWT_SECRET, ENCRYPTION_KEY, passwords)
# 2. Update GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET
# 3. Set strong passwords for POSTGRES_PASSWORD and REDIS_PASSWORD
# 4. Configure MINIO_ACCESS_KEY and MINIO_SECRET_KEY
# 5. Set production domain in GOOGLE_REDIRECT_URI and CORS_ORIGINS
# 6. Enable SECURE_COOKIES=true
# 7. Disable DEBUG=false
# 8. Disable ENABLE_API_DOCS=false
# 9. Configure monitoring (SENTRY_DSN)
# 10. Set up SSL/TLS with reverse proxy (nginx/Caddy)
# 11. Create data directory: mkdir -p /var/lib/openahrush/{postgres,redis,minio,clickhouse}
# 12. Set permissions: chown -R 999:999 /var/lib/openahrush/postgres
# 13. Backup this file securely (contains secrets)
# 14. Never commit this file to version control

# ============================================================================
# Security Checklist
# ============================================================================

# - [ ] All secrets generated (not using defaults)
# - [ ] Strong passwords (min 20 chars, mixed case, numbers, symbols)
# - [ ] JWT_SECRET >= 32 characters
# - [ ] ENCRYPTION_KEY is valid Fernet key
# - [ ] SECURE_COOKIES=true
# - [ ] DEBUG=false
# - [ ] ENABLE_API_DOCS=false (or behind authentication)
# - [ ] CORS_ORIGINS set to specific domains (not *)
# - [ ] SSL/TLS configured on reverse proxy
# - [ ] Firewall configured (ports 80, 443 only)
# - [ ] Database passwords changed from defaults
# - [ ] MinIO/S3 credentials secured
# - [ ] OAuth redirect URIs use HTTPS
# - [ ] Monitoring configured (Sentry, logs)
# - [ ] Backups scheduled (database, volumes)

# ============================================================================
# Performance Tuning (Adjust based on server resources)
# ============================================================================

# For small server (2 CPU, 4 GB RAM):
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# REDIS_MAXMEMORY=256mb
# POSTGRES_SHARED_BUFFERS=256MB
# POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
# WORKER_CONCURRENCY=2

# For medium server (4 CPU, 8 GB RAM):
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=40
# REDIS_MAXMEMORY=512mb
# POSTGRES_SHARED_BUFFERS=512MB
# POSTGRES_EFFECTIVE_CACHE_SIZE=2GB
# WORKER_CONCURRENCY=4

# For large server (8+ CPU, 16+ GB RAM):
# DB_POOL_SIZE=50
# DB_MAX_OVERFLOW=100
# REDIS_MAXMEMORY=1gb
# POSTGRES_SHARED_BUFFERS=1GB
# POSTGRES_EFFECTIVE_CACHE_SIZE=4GB
# WORKER_CONCURRENCY=8
